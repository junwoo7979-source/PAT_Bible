d":"GEN.1","bookId":"GEN","chapterNumber":1},{"chapterId":"PSA.1","bookId":"PSA","chapterNumber":1},{"chapterId":"PSA.23","bookId":"PSA","chapterNumber":23},{"chapterId":"PRO.1","bookId":"PRO","chapterNumber":1},{"chapterId":"MAT.1","bookId":"MAT","chapterNumber":1},{"chapterId":"JHN.3","bookId":"JHN","chapterNumber":3}],"verses":[{"verseId":"GEN.1.1","bookId":"GEN","chapterNumber":1,"verseNumber":1,"text":"태초에 하나님이 천지를 창조하시니라"},{"verseId":"GEN.1.2","bookId":"GEN","chapterNumber":1,"verseNumber":2,"text":"땅이 혼돈하고 공허하며 흑암이 깊음 위에 있고 하나님의 신은 수면에 운행하시니라"},{"verseId":"GEN.1.3","bookId":"GEN","chapterNumber":1,"verseNumber":3,"text":"하나님이 가라사대 빛이 있으라 하시매 빛이 있었고"},{"verseId":"GEN.1.4","bookId":"GEN","chapterNumber":1,"verseNumber":4,"text":"그 빛이 하나님의 보시기에 좋았더라 하나님이 빛과 어두움을 나누사"},{"verseId":"GEN.1.5","bookId":"GEN","chapterNumber":1,"verseNumber":5,"text":"하나님이 빛을 낮이라 칭하시고 어두움을 밤이라 칭하시니라 저녁이 되며 아침이 되니 이는 첫째 날이니라"},{"verseId":"PSA.1.1","bookId":"PSA","chapterNumber":1,"verseNumber":1,"text":"복 있는 사람은 악인의 꾀를 좇지 아니하며 죄인의 길에 서지 아니하며 오만한 자의 자리에 앉지 아니하고"},{"verseId":"PSA.1.2","bookId":"PSA","chapterNumber":1,"verseNumber":2,"text":"오직 여호와의 율법을 즐거워하여 그 율법을 주야로 묵상하는 자로다"},{"verseId":"PSA.1.3","bookId":"PSA","chapterNumber":1,"verseNumber":3,"text":"저는 시냇가에 심은 나무가 시절을 좇아 과실을 맺으며 그 잎사귀가 마르지 아니함 같으니 그 행사가 다 형통하리로다"},{"verseId":"PSA.1.4","bookId":"PSA","chapterNumber":1,"verseNumber":4,"text":"악인은 그렇지 않음이여 오직 바람에 나는 겨와 같도다"},{"verseId":"PSA.1.5","bookId":"PSA","chapterNumber":1,"verseNumber":5,"text":"그러므로 악인이 심판을 견디지 못하며 죄인이 의인의 회중에 들지 못하리로다"},{"verseId":"PSA.1.6","bookId":"PSA","chapterNumber":1,"verseNumber":6,"text":"대저 의인의 길은 여호와께서 인정하시나 악인의 길은 망하리로다"},{"verseId":"PSA.23.1","bookId":"PSA","chapterNumber":23,"verseNumber":1,"text":"여호와는 나의 목자시니 내가 부족함이 없으리로다"},{"verseId":"PSA.23.2","bookId":"PSA","chapterNumber":23,"verseNumber":2,"text":"그가 나를 푸른 초장에 누이시며 쉴만한 물 가으로 인도하시는도다"},{"verseId":"PSA.23.3","bookId":"PSA","chapterNumber":23,"verseNumber":3,"text":"내 영혼을 소생시키시고 자기 이름을 위하여 의의 길로 인도하시는도다"},{"verseId":"PSA.23.4","bookId":"PSA","chapterNumber":23,"verseNumber":4,"text":"내가 사망의 음침한 골짜기로 다닐지라도 해를 두려워하지 않을 것은 주께서 나와 함께 하심이라 주의 지팡이와 막대기가 나를 안위하시나이다"},{"verseId":"PSA.23.5","bookId":"PSA","chapterNumber":23,"verseNumber":5,"text":"주께서 내 원수의 목전에서 내게 상을 베푸시고 기름으로 내 머리에 바르셨으니 내 잔이 넘치나이다"},{"verseId":"PSA.23.6","bookId":"PSA","chapterNumber":23,"verseNumber":6,"text":"나의 평생에 선하심과 인자하심이 정녕 나를 따르리니 내가 여호와의 집에 영원히 거하리로다"},{"verseId":"PRO.1.1","bookId":"PRO","chapterNumber":1,"verseNumber":1,"text":"다윗의 아들 이스라엘 왕 솔로몬의 잠언이라"},{"verseId":"PRO.1.2","bookId":"PRO","chapterNumber":1,"verseNumber":2,"text":"이는 지혜와 훈계를 알게 하며 명철의 말씀을 깨닫게 하며"},{"verseId":"PRO.1.3","bookId":"PRO","chapterNumber":1,"verseNumber":3,"text":"지혜롭게, 의롭게, 공평하게, 정직하게, 행할 일에 대하여 훈계를 받게 하며"},{"verseId":"PRO.1.4","bookId":"PRO","chapterNumber":1,"verseNumber":4,"text":"어리석은 자로 슬기롭게 하며 젊은 자에게 지식과 근신함을 주기 위한 것이니"},{"verseId":"PRO.1.5","bookId":"PRO","chapterNumber":1,"verseNumber":5,"text":"지혜있는 자는 듣고 학식이 더할 것이요 명철한 자는 모략을 얻을 것이라"},{"verseId":"PRO.1.6","bookId":"PRO","chapterNumber":1,"verseNumber":6,"text":"잠언과 비유와 지혜있는 자의 말과 그 오묘한 말을 깨달으리라"},{"verseId":"PRO.1.7","bookId":"PRO","chapterNumber":1,"verseNumber":7,"text":"여호와를 경외하는 것이 지식의 근본이어늘 미련한 자는 지혜와 훈계를 멸시하느니라"},{"verseId":"MAT.1.1","bookId":"MAT","chapterNumber":1,"verseNumber":1,"text":"아브라함과 다윗의 자손 예수 그리스도의 세계라"},{"verseId":"JHN.3.16","bookId":"JHN","chapterNumber":3,"verseNumber":16,"text":"하나님이 세상을 이처럼 사랑하사 독생자를 주셨으니 이는 저를 믿는 자마다 멸망치 않고 영생을 얻게 하려 하심이니라"}]}