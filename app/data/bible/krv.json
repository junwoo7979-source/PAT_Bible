Id":"ROM","bookNameKo":"로마서","bookNameEn":"Romans","testament":"NT","order":45},{"bookId":"1CO","bookNameKo":"고린도전서","bookNameEn":"1 Corinthians","testament":"NT","order":46},{"bookId":"2CO","bookNameKo":"고린도후서","bookNameEn":"2 Corinthians","testament":"NT","order":47},{"bookId":"GAL","bookNameKo":"갈라디아서","bookNameEn":"Galatians","testament":"NT","order":48},{"bookId":"EPH","bookNameKo":"에베소서","bookNameEn":"Ephesians","testament":"NT","order":49},{"bookId":"PHP","bookNameKo":"빌립보서","bookNameEn":"Philippians","testament":"NT","order":50},{"bookId":"COL","bookNameKo":"골로새서","bookNameEn":"Colossians","testament":"NT","order":51},{"bookId":"1TH","bookNameKo":"데살로니가전서","bookNameEn":"1 Thessalonians","testament":"NT","order":52},{"bookId":"2TH","bookNameKo":"데살로니가후서","bookNameEn":"2 Thessalonians","testament":"NT","order":53},{"bookId":"1TI","bookNameKo":"디모데전서","bookNameEn":"1 Timothy","testament":"NT","order":54},{"bookId":"2TI","bookNameKo":"디모데후서","bookNameEn":"2 Timothy","testament":"NT","order":55},{"bookId":"TIT","bookNameKo":"디도서","bookNameEn":"Titus","testament":"NT","order":56},{"bookId":"PHM","bookNameKo":"빌레몬서","bookNameEn":"Philemon","testament":"NT","order":57},{"bookId":"HEB","bookNameKo":"히브리서","bookNameEn":"Hebrews","testament":"NT","order":58},{"bookId":"JAS","bookNameKo":"야고보서","bookNameEn":"James","testament":"NT","order":59},{"bookId":"1PE","bookNameKo":"베드로전서","bookNameEn":"1 Peter","testament":"NT","order":60},{"bookId":"2PE","bookNameKo":"베드로후서","bookNameEn":"2 Peter","testament":"NT","order":61},{"bookId":"1JN","bookNameKo":"요한일서","bookNameEn":"1 John","testament":"NT","order":62},{"bookId":"2JN","bookNameKo":"요한이서","bookNameEn":"2 John","testament":"NT","order":63},{"bookId":"3JN","bookNameKo":"요한삼서","bookNameEn":"3 John","testament":"NT","order":64},{"bookId":"JUD","bookNameKo":"유다서","bookNameEn":"Jude","testament":"NT","order":65},{"bookId":"REV","bookNameKo":"요한계시록","bookNameEn":"Revelation","testament":"NT","order":66}],"chapters":[{"chapterId":"GEN.1","bookId":"GEN","chapterNumber":1},{"chapterId":"PSA.1","bookId":"PSA","chapterNumber":1},{"chapterId":"PSA.23","bookId":"PSA","chapterNumber":23},{"chapterId":"PRO.1","bookId":"PRO","chapterNumber":1},{"chapterId":"MAT.1","bookId":"MAT","chapterNumber":1},{"chapterId":"JHN.3","bookId":"JHN","chapterNumber":3},{"chapterId":"PSA.9","bookId":"PSA","chapterNumber":9}],"verses":[{"verseId":"GEN.1.1","bookId":"GEN","chapterNumber":1,"verseNumber":1,"text":"태초에 하나님이 천지를 창조하시니라"},{"verseId":"GEN.1.2","bookId":"GEN","chapterNumber":1,"verseNumber":2,"text":"땅이 혼돈하고 공허하며 흑암이 깊음 위에 있고 하나님의 신은 수면에 운행하시니라"},{"verseId":"GEN.1.3","bookId":"GEN","chapterNumber":1,"verseNumber":3,"text":"하나님이 가라사대 빛이 있으라 하시매 빛이 있었고"},{"verseId":"GEN.1.4","bookId":"GEN","chapterNumber":1,"verseNumber":4,"text":"그 빛이 하나님의 보시기에 좋았더라 하나님이 빛과 어두움을 나누사"},{"verseId":"GEN.1.5","bookId":"GEN","chapterNumber":1,"verseNumber":5,"text":"하나님이 빛을 낮이라 칭하시고 어두움을 밤이라 칭하시니라 저녁이 되며 아침이 되니 이는 첫째 날이니라"},{"verseId":"PSA.1.1","bookId":"PSA","chapterNumber":1,"verseNumber":1,"text":"복 있는 사람은 악인의 꾀를 좇지 아니하며 죄인의 길에 서지 아니하며 오만한 자의 자리에 앉지 아니하고"},{"verseId":"PSA.1.2","bookId":"PSA","chapterNumber":1,"verseNumber":2,"text":"오직 여호와의 율법을 즐거워하여 그 율법을 주야로 묵상하는 자로다"},{"verseId":"PSA.1.3","bookId":"PSA","chapterNumber":1,"verseNumber":3,"text":"저는 시냇가에 심은 나무가 시절을 좇아 과실을 맺으며 그 잎사귀가 마르지 아니함 같으니 그 행사가 다 형통하리로다"},{"verseId":"PSA.1.4","bookId":"PSA","chapterNumber":1,"verseNumber":4,"text":"악인은 그렇지 않음이여 오직 바람에 나는 겨와 같도다"},{"verseId":"PSA.1.5","bookId":"PSA","chapterNumber":1,"verseNumber":5,"text":"그러므로 악인이 심판을 견디지 못하며 죄인이 의인의 회중에 들지 못하리로다"},{"verseId":"PSA.1.6","bookId":"PSA","chapterNumber":1,"verseNumber":6,"text":"대저 의인의 길은 여호와께서 인정하시나 악인의 길은 망하리로다"},{"verseId":"PSA.23.1","bookId":"PSA","chapterNumber":23,"verseNumber":1,"text":"여호와는 나의 목자시니 내가 부족함이 없으리로다"},{"verseId":"PSA.23.2","bookId":"PSA","chapterNumber":23,"verseNumber":2,"text":"그가 나를 푸른 초장에 누이시며 쉴만한 물 가으로 인도하시는도다"},{"verseId":"PSA.23.3","bookId":"PSA","chapterNumber":23,"verseNumber":3,"text":"내 영혼을 소생시키시고 자기 이름을 위하여 의의 길로 인도하시는도다"},{"verseId":"PSA.23.4","bookId":"PSA","chapterNumber":23,"verseNumber":4,"text":"내가 사망의 음침한 골짜기로 다닐지라도 해를 두려워하지 않을 것은 주께서 나와 함께 하심이라 주의 지팡이와 막대기가 나를 안위하시나이다"},{"verseId":"PSA.23.5","bookId":"PSA","chapterNumber":23,"verseNumber":5,"text":"주께서 내 원수의 목전에서 내게 상을 베푸시고 기름으로 내 머리에 바르셨으니 내 잔이 넘치나이다"},{"verseId":"PSA.23.6","bookId":"PSA","chapterNumber":23,"verseNumber":6,"text":"나의 평생에 선하심과 인자하심이 정녕 나를 따르리니 내가 여호와의 집에 영원히 거하리로다"},{"verseId":"PRO.1.1","bookId":"PRO","chapterNumber":1,"verseNumber":1,"text":"다윗의 아들 이스라엘 왕 솔로몬의 잠언이라"},{"verseId":"PRO.1.2","bookId":"PRO","chapterNumber":1,"verseNumber":2,"text":"이는 지혜와 훈계를 알게 하며 명철의 말씀을 깨닫게 하며"},{"verseId":"PRO.1.3","bookId":"PRO","chapterNumber":1,"verseNumber":3,"text":"지혜롭게, 의롭게, 공평하게, 정직하게, 행할 일에 대하여 훈계를 받게 하며"},{"verseId":"PRO.1.4","bookId":"PRO","chapterNumber":1,"verseNumber":4,"text":"어리석은 자로 슬기롭게 하며 젊은 자에게 지식과 근신함을 주기 위한 것이니"},{"verseId":"PRO.1.5","bookId":"PRO","chapterNumber":1,"verseNumber":5,"text":"지혜있는 자는 듣고 학식이 더할 것이요 명철한 자는 모략을 얻을 것이라"},{"verseId":"PRO.1.6","bookId":"PRO","chapterNumber":1,"verseNumber":6,"text":"잠언과 비유와 지혜있는 자의 말과 그 오묘한 말을 깨달으리라"},{"verseId":"PRO.1.7","bookId":"PRO","chapterNumber":1,"verseNumber":7,"text":"여호와를 경외하는 것이 지식의 근본이어늘 미련한 자는 지혜와 훈계를 멸시하느니라"},{"verseId":"MAT.1.1","bookId":"MAT","chapterNumber":1,"verseNumber":1,"text":"아브라함과 다윗의 자손 예수 그리스도의 세계라"},{"verseId":"JHN.3.16","bookId":"JHN","chapterNumber":3,"verseNumber":16,"text":"하나님이 세상을 이처럼 사랑하사 독생자를 주셨으니 이는 저를 믿는 자마다 멸망치 않고 영생을 얻게 하려 하심이니라"},{"verseId":"PSA.9.1","bookId":"PSA","chapterNumber":9,"verseNumber":1,"text":"내가 전심으로 여호와께 감사하오며 주의 모든 기사를 전하리이다"},{"verseId":"PSA.9.2","bookId":"PSA","chapterNumber":9,"verseNumber":2,"text":"내가 주를 기뻐하고 즐거워하며 지존하신 주의 이름을 찬송하리니"},{"verseId":"PSA.9.3","bookId":"PSA","chapterNumber":9,"verseNumber":3,"text":"내 원수들이 물러갈 때에 주의 앞에서 넘어져 망함이니이다"},{"verseId":"PSA.9.4","bookId":"PSA","chapterNumber":9,"verseNumber":4,"text":"주께서 나의 의와 송사를 변호하셨으며 보좌에 앉으사 의롭게 심판하셨나이다"},{"verseId":"PSA.9.5","bookId":"PSA","chapterNumber":9,"verseNumber":5,"text":"열방을 책하시고 악인을 멸하시며 저희 이름을 영영히 도말하셨나이다"},{"verseId":"PSA.9.6","bookId":"PSA","chapterNumber":9,"verseNumber":6,"text":"원수가 끊어져 영영히 멸망하셨사오니 주께서 무너뜨린 성읍들을 기억할 수 없나이다"},{"verseId":"PSA.9.7","bookId":"PSA","chapterNumber":9,"verseNumber":7,"text":"여호와께서 영영히 앉으심이여 심판을 위하여 보좌를 예비하셨도다"},{"verseId":"PSA.9.8","bookId":"PSA","chapterNumber":9,"verseNumber":8,"text":"공의로 세계를 심판하심이여 정직으로 만민에게 판단을 행하시리로다"},{"verseId":"PSA.9.9","bookId":"PSA","chapterNumber":9,"verseNumber":9,"text":"여호와는 압제를 당하는 자의 산성이시요 환난 때의 산성이시로다"},{"verseId":"PSA.9.10","bookId":"PSA","chapterNumber":9,"verseNumber":10,"text":"여호와여 주의 이름을 아는 자는 주를 의지하오리니 이는 주를 찾는 자들을 버리지 아니하심이니이다"},{"verseId":"PSA.9.11","bookId":"PSA","chapterNumber":9,"verseNumber":11,"text":"너희는 시온에 거하신 여호와를 찬송하며 그 행사를 백성 중에 선포할지어다"},{"verseId":"PSA.9.12","bookId":"PSA","chapterNumber":9,"verseNumber":12,"text":"피 흘림을 심문하시는 이가 저희를 기억하심이여 가난한 자의 부르짖음을 잊지 아니하시도다"},{"verseId":"PSA.9.13","bookId":"PSA","chapterNumber":9,"verseNumber":13,"text":"여호와여 나를 긍휼히 여기소서 나를 사망의 문에서 일으키시는 주여 미워하는 자에게 받는 나의 곤고를 보소서"},{"verseId":"PSA.9.14","bookId":"PSA","chapterNumber":9,"verseNumber":14,"text":"그리하시면 내가 주의 찬송을 다 전할 것이요 딸 시온의 문에서 주의 구원을 기뻐하리이다"},{"verseId":"PSA.9.15","bookId":"PSA","chapterNumber":9,"verseNumber":15,"text":"열방은 자기가 판 웅덩이에 빠짐이여 그 숨긴 그물에 자기 발이 걸렸도다"},{"verseId":"PSA.9.16","bookId":"PSA","chapterNumber":9,"verseNumber":16,"text":"여호와께서 자기를 알게 하사 심판을 행하셨음이여 악인은 자기 손으로 행한 일에 스스로 얽혔도다"},{"verseId":"PSA.9.17","bookId":"PSA","chapterNumber":9,"verseNumber":17,"text":"악인이 음부로 돌아감이여 하나님을 잊어버린 모든 열방이 그리하리로다"},{"verseId":"PSA.9.18","bookId":"PSA","chapterNumber":9,"verseNumber":18,"text":"궁핍한 자가 항상 잊어버림을 보지 아니함이여 가난한 자가 영영히 실망치 아니하리로다"},{"verseId":"PSA.9.19","bookId":"PSA","chapterNumber":9,"verseNumber":19,"text":"여호와여 일어나사 인생으로 승리를 얻지 못하게 하시며 열방으로 주의 목전에 심판을 받게 하소서"},{"verseId":"PSA.9.20","bookId":"PSA","chapterNumber":9,"verseNumber":20,"text":"여호와여 저희로 두렵게 하시며 열방으로 자기는 인생 뿐인 줄 알게 하소서"}]}