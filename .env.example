# Copy this file to .env.local and fill in real values.
# Never commit .env.local.

KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:8766/oauth/kakao
KAKAO_LOCAL_PORT=8766
KAKAO_CALLBACK_PATH=/oauth/kakao

# Optional card news overrides
PAT_MARKET_BRIEF_TITLE=미국증시 장 마감 브리핑
PAT_MARKET_BRIEF_SUMMARY=AI 반도체와 서버 인프라 흐름을 점검하고 국내 증시 영향을 정리했습니다.
PAT_MARKET_BRIEF_URL=https://example.com/pat-market-brief
PAT_MARKET_BRIEF_IMAGE_URL=https://example.com/pat-card-news-cover.png
