# Copy this file to .env.local and fill in real values.
# Never commit .env.local.

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8766/oauth/kakao
KAKAO_LOCAL_PORT=8766
KAKAO_CALLBACK_PATH=/oauth/kakao

# ─────────────────────────────────────────────────────────────
# Firebase Auth (관리자 전용) — 클라이언트 SDK 공개 설정
#   ※ 이 앱은 빌드 스텝이 없는 정적 호스팅이라 환경변수 치환이 안 된다.
#     실제 값은 Firebase Console(프로젝트 설정 → 내 앱 → 웹 앱)에서 복사해
#     app/firebase-config.js 의 window.FIREBASE_CLIENT_CONFIG 에 직접 채운다.
#   ※ apiKey 등은 "공개용 클라이언트 config"로 노출돼도 안전(진짜 비밀 아님).
#     진짜 비밀 = 서비스 계정 키 → 프런트엔드/깃에 절대 포함 금지.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=pat-bible-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pat-bible-app
VITE_FIREBASE_STORAGE_BUCKET=pat-bible-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Admin SDK 스크립트(scripts/set-admin.mjs)용 — 서비스 계정 키 경로(로컬 전용, 커밋 금지)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/serviceAccountKey.json

# Optional card news overrides
PAT_MARKET_BRIEF_TITLE=미국증시 장 마감 브리핑
PAT_MARKET_BRIEF_SUMMARY=AI 반도체와 서버 인프라 흐름을 점검하고 국내 증시 영향을 정리했습니다.
PAT_MARKET_BRIEF_URL=https://junwoo7979-source.github.io/pat-market-brief/
PAT_MARKET_BRIEF_IMAGE_URL=https://opengraph.githubassets.com/1/junwoo7979-source/pat-market-brief
